{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/rulepack-1.json",
  "title": "Distiller rule pack, format rulepack/1",
  "description": "The shape of a rule pack file (docs/spec/02-engine.md §2.2). The loader checks more than this schema: pattern subset, validator names, category use, fake values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "version",
    "categories",
    "rules",
    "dictionaries",
    "neutralise_literals"
  ],
  "properties": {
    "format": {
      "const": "rulepack/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "surrogate"
        ],
        "properties": {
          "class": {
            "enum": [
              "high",
              "medium",
              "low",
              "defend"
            ]
          },
          "surrogate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/patternRule"
          },
          {
            "$ref": "#/$defs/termsRule"
          }
        ]
      }
    },
    "dictionaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "template",
          "terms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "category": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "pattern": "\\{n\\}"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "neutralise_literals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "action": {
      "enum": [
        "redact",
        "flag",
        "neutralise",
        "block"
      ]
    },
    "patternRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "kind",
        "pattern",
        "flags",
        "edges",
        "validators",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "pattern"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "string",
          "pattern": "^i?m?$|^m?i?$"
        },
        "edges": {
          "enum": [
            "word",
            "numeric",
            "word_before", "word_colon",
            "none"
          ]
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "variant": {
          "type": "string"
        }
      }
    },
    "termsRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "kind",
        "terms",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "terms"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "variant": {
          "type": "string"
        }
      }
    }
  }
}
